# Local app
DATABASE_PATH=./data/finance.db
DEMO_MODE=true
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=

# OpenAI: WhatsApp audio transcription and expense extraction
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_EXTRACTION_MODEL=gpt-4o-mini
# Free local model for browser custom voice transcription (downloads on first use)
LOCAL_WHISPER_MODEL=base

# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=v23.0

# Retell custom-function endpoint protection. Configure the same value as
# an Authorization: Bearer header in the Retell custom function.
RETELL_FUNCTION_SECRET=
# Retell API key with webhook verification enabled (badge in Retell dashboard)
RETELL_API_KEY=
# Retell public key is intended for browser use; restrict its allowed domain in Retell.
RETELL_PUBLIC_KEY=
RETELL_AGENT_ID=
RETELL_PHONE_NUMBER=
AUTHORIZED_PHONE_NUMBERS=
